---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';

import Kopf from '../components/Kopf.astro';
import Fuss from '../components/Fuss.astro';
import { getLocale, locales, localizePath, t } from '../i18n';
import { SITE_INDEXABLE } from '../config';
import { getBild } from '../lib/bilder';
import tokens from '../../design/tokens.json';

interface Props {
  /** Seitentitel ohne Namen; leer = nur «Charlotte Lingg» */
  title?: string;
  description?: string;
  /** false, wenn es die Seite nicht in der anderen Sprache gibt */
  hasTranslation?: boolean;
  /** true = Suchmaschinen sollen die Seite nicht aufnehmen */
  noindex?: boolean;
  /** Strukturierte Daten (JSON-LD), z. B. Typ Person auf der Startseite */
  jsonLd?: Record<string, unknown>;
}

const locale = getLocale(Astro.currentLocale);
const siteName = t(locale, 'site.name');
const {
  title,
  description = t(locale, 'site.description'),
  hasTranslation = true,
  noindex = false,
  jsonLd,
} = Astro.props;

const robotsNoindex = noindex || !SITE_INDEXABLE;
/** Beginnt der Titel bereits mit dem Namen (z. B. FR-Startseite), wird er unverändert übernommen. */
const fullTitle = !title ? siteName : title.startsWith(siteName) ? title : `${title} – ${siteName}`;
const site = Astro.site ?? new URL('https://charlottelingg.com');
const canonical = new URL(Astro.url.pathname, site);
const alternates = hasTranslation
  ? locales.map((l) => ({ locale: l, href: new URL(localizePath(Astro.url.pathname, l), site).href }))
  : [];
const ogLocale = locale === 'fr' ? 'fr_CH' : 'de_CH';
/** Vorschaubild beim Teilen. Ohne geklärte Lizenz (und ohne Entwürfe) gibt es kein og:image. */
const ogBild = await getBild('og-charlotte-lingg', locale);
const ogBildUrl = ogBild && new URL(ogBild.datei, site).href;
const ogBildTyp = { webp: 'image/webp', png: 'image/png', jpg: 'image/jpeg' }[ogBild?.datei.split('.').pop() ?? 'jpg'];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {robotsNoindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical.href} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={a.href} />)}
    {
      alternates.length > 0 && (
        <link rel="alternate" hreflang="x-default" href={new URL(localizePath(Astro.url.pathname, 'de'), site).href} />
      )
    }

    <!-- Favicon: Platzhalter, wird durch das finale Zeichen ersetzt -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={tokens.themen.beere.color.beere} />

    <!-- Open Graph (Basis) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={ogLocale} />
    {
      locales
        .filter((l) => l !== locale && hasTranslation)
        .map((l) => <meta property="og:locale:alternate" content={l === 'fr' ? 'fr_CH' : 'de_CH'} />)
    }
    {
      ogBild && ogBildUrl && (
        <>
          <meta property="og:image" content={ogBildUrl} />
          <meta property="og:image:type" content={ogBildTyp} />
          <meta property="og:image:width" content={String(ogBild.breite)} />
          <meta property="og:image:height" content={String(ogBild.hoehe)} />
          <meta property="og:image:alt" content={ogBild.alt} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={ogBildUrl} />
          <meta name="twitter:image:alt" content={ogBild.alt} />
        </>
      )
    }
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip-link" href="#inhalt">{t(locale, 'skip.link')}</a>
    <Kopf locale={locale} hasTranslation={hasTranslation} />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Fuss locale={locale} />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
