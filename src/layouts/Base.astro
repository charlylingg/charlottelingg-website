---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';

import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { getLocale, locales, localizePath, t } from '../i18n';

interface Props {
  /** Seitentitel ohne Namen; leer = nur «Charlotte Lingg» */
  title?: string;
  description?: string;
  /** false, wenn es die Seite nicht in der anderen Sprache gibt */
  hasTranslation?: boolean;
  /** true = Suchmaschinen sollen die Seite nicht aufnehmen */
  noindex?: boolean;
}

const locale = getLocale(Astro.currentLocale);
const siteName = t(locale, 'site.name');
const {
  title,
  description = t(locale, 'site.description'),
  hasTranslation = true,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} – ${siteName}` : siteName;
const site = Astro.site ?? new URL('https://charlottelingg.com');
const canonical = new URL(Astro.url.pathname, site);
const alternates = hasTranslation
  ? locales.map((l) => ({ locale: l, href: new URL(localizePath(Astro.url.pathname, l), site).href }))
  : [];
const ogLocale = locale === 'fr' ? 'fr_CH' : 'de_CH';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical.href} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={a.href} />)}
    {
      alternates.length > 0 && (
        <link rel="alternate" hreflang="x-default" href={new URL(localizePath(Astro.url.pathname, 'de'), site).href} />
      )
    }

    <!-- Favicon: Platzhalter, wird durch das finale Zeichen ersetzt -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#002b7f" />

    <!-- Open Graph (Basis) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={ogLocale} />
    {
      locales
        .filter((l) => l !== locale && hasTranslation)
        .map((l) => <meta property="og:locale:alternate" content={l === 'fr' ? 'fr_CH' : 'de_CH'} />)
    }
    <!-- og:image folgt, sobald ein freigegebenes Bild vorliegt (siehe LIZENZEN.md) -->
  </head>
  <body>
    <a class="skip-link" href="#inhalt">{t(locale, 'skip.link')}</a>
    <header class="kopf container">
      <a class="kopf__name t-label" href={localizePath('/', locale)}>{siteName}</a>
      <LanguageSwitcher locale={locale} hasTranslation={hasTranslation} />
    </header>
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
  </body>
</html>

<style>
  .kopf {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-line-soft);
  }

  .kopf__name {
    color: var(--color-ink);
    text-decoration: none;
  }

  main:focus {
    outline: none;
  }
</style>
