---
/**
 * 404-Seite, zweisprachig auf einer Seite (Cloudflare liefert sie für jede unbekannte Adresse aus).
 */
import Base from '../layouts/Base.astro';
import Torflagge from '../components/Torflagge.astro';
import { localizePath, t, type Locale } from '../i18n';

const sprachen: Locale[] = ['de', 'fr'];
---

<Base title={`404 – ${t('de', '404.titel')}`} hasTranslation={false} noindex>
  <section class="fehler inhalt sektion">
    <div class="fehler__kopf">
      <Torflagge farbe="rosa" breite={28} hoehe={88} />
      <p class="fehler__zahl" aria-hidden="true">404</p>
    </div>
    <div class="fehler__sprachen">
      {
        sprachen.map((l) => (
          <div lang={l} class="fehler__block">
            {l === 'de' ? (
              <h1 class="t-titel">{t(l, '404.titel')}</h1>
            ) : (
              <h2 class="t-titel">{t(l, '404.titel')}</h2>
            )}
            <p class="t-lead fehler__text">{t(l, '404.text')}</p>
            <a class="knopf knopf--beere t-knopf fehler__link" href={localizePath('/', l)}>
              {t(l, '404.link')}
            </a>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .fehler {
    display: grid;
    align-content: center;
    gap: var(--space-48);
  }

  .fehler__kopf {
    display: flex;
    align-items: flex-end;
    gap: var(--space-24);
    padding-left: var(--space-16);
  }

  .fehler__zahl {
    font-family: var(--font-display);
    font-size: var(--size-72);
    font-weight: var(--weight-700);
    line-height: var(--line-100);
    color: var(--color-beere);
  }

  .fehler__sprachen {
    display: grid;
    gap: var(--space-48);
  }

  @media (min-width: 821px) {
    .fehler__sprachen {
      grid-template-columns: 1fr 1fr;
    }
  }

  .fehler__block {
    min-width: 0;
    display: grid;
    justify-items: start;
    gap: var(--space-20);
    padding-top: var(--space-24);
    border-top: var(--linie-1) solid var(--color-linie);
  }

  .fehler__text {
    color: var(--color-tinte-soft);
    max-width: var(--mass-30rem);
  }
</style>
