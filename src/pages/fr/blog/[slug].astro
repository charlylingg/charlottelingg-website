---
import BlogBeitrag from '../../../components/BlogBeitrag.astro';
import { getBlogSeiten } from '../../../lib/inhalte';

export async function getStaticPaths() {
  const de = new Set((await getBlogSeiten('de')).map((b) => b.slug));
  return (await getBlogSeiten('fr')).map((beitrag) => ({
    params: { slug: beitrag.slug },
    props: { beitrag, hasTranslation: de.has(beitrag.slug) },
  }));
}

const { beitrag, hasTranslation } = Astro.props;
---

<BlogBeitrag locale="fr" beitrag={beitrag} hasTranslation={hasTranslation} />
