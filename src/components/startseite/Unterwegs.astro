---
/**
 * Unterwegs: Hinweis auf Instagram mit den sechs neuesten Beiträgen als Kacheln.
 * Die Bilder liegen im Repository (src/assets/instagram/) und werden von der Website selbst ausgeliefert:
 * kein eingebetteter Feed, keine externen Skripte, keine Bilder von Instagram, Meta oder Behold.
 * Ohne Beiträge (src/data/instagram.json fehlt oder ist leer) erscheinen die Platzhalter-Kacheln.
 */
import { Picture } from 'astro:assets';
import EntwurfLabel from '../EntwurfLabel.astro';
import { getText } from '../../lib/inhalte';
import { getInstagramBeitraege } from '../../lib/instagram';
import { datum } from '../../lib/format';
import { t, tf, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = await getText(locale, 'unterwegs');
/** Kacheln wie im Design: Fläche und Farbe des Instagram-Zeichens */
const kacheln = [
  { flaeche: 'hauch', zeichen: 'beere' },
  { flaeche: 'hauch-2', zeichen: 'beere' },
  { flaeche: 'hauch', zeichen: 'rosa' },
  { flaeche: 'hauch-2', zeichen: 'rosa' },
  { flaeche: 'hauch', zeichen: 'beere' },
  { flaeche: 'hauch-2', zeichen: 'beere' },
];
const beitraege = getInstagramBeitraege().slice(0, kacheln.length);
/** Hat der Feed weniger als 6 Beiträge, füllen Platzhalter das Raster auf */
const fuellkacheln = kacheln.slice(beitraege.length);
/** Kachelbreite: Desktop bis 216px, darunter ein Drittel der Inhaltsbreite */
const kachelSizes = '(min-width: 1280px) 216px, (min-width: 868px) 17vw, 31vw';
const kachelWidths = [120, 160, 240, 320, 440, 540];
---

<svg width="0" height="0" class="visually-hidden" aria-hidden="true">
  <symbol id="instagram-zeichen" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="3" width="18" height="18" rx="5"></rect>
    <circle cx="12" cy="12" r="4"></circle>
    <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"></circle>
  </symbol>
</svg>

{
  text && (
    <section
      id="unterwegs"
      class="unterwegs flaeche-papier sektion"
      aria-labelledby="unterwegs-titel"
      lang={text.lang !== locale ? text.lang : undefined}
    >
      <div class="unterwegs__innen inhalt">
        <div class="unterwegs__text">
          {text.entwurf && <EntwurfLabel locale={locale} />}
          <p class="kicker-flagge t-kicker">{text.data.kicker}</p>
          <h2 id="unterwegs-titel" class="t-titel">
            {text.data.titel}
          </h2>
          <p>{text.data.text}</p>
          <a class="knopf knopf--beere t-knopf unterwegs__knopf" href={text.data.instagram.url} target="_blank" rel="noopener">
            <svg class="unterwegs__zeichen" aria-hidden="true">
              <use href="#instagram-zeichen" />
            </svg>
            {text.data.instagram.text}
            <span class="visually-hidden">{t(locale, 'link.neues_fenster')}</span>
          </a>
        </div>
        {beitraege.length > 0 ? (
          <div class="kacheln">
            {beitraege.map((b) => (
              <a
                class="kachel kachel--beitrag"
                href={b.permalink}
                target="_blank"
                rel="noopener"
                aria-label={tf(locale, 'unterwegs.beitrag', { datum: datum(b.datum) })}
                lang={text.lang !== locale ? locale : undefined}
              >
                <Picture
                  class="kachel__bild"
                  src={b.bildDaten}
                  formats={['avif', 'webp']}
                  widths={kachelWidths}
                  sizes={kachelSizes}
                  width={b.breite}
                  height={b.hoehe}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ))}
            {fuellkacheln.map((k) => (
              <span
                class="kachel"
                style={`background: var(--color-${k.flaeche}); color: var(--color-${k.zeichen})`}
                aria-hidden="true"
              >
                <svg class="kachel__zeichen">
                  <use href="#instagram-zeichen" />
                </svg>
              </span>
            ))}
          </div>
        ) : (
          <a
            class="kacheln"
            href={text.data.instagram.url}
            target="_blank"
            rel="noopener"
            tabindex="-1"
            aria-hidden="true"
          >
            {kacheln.map((k) => (
              <span class="kachel" style={`background: var(--color-${k.flaeche}); color: var(--color-${k.zeichen})`}>
                <svg class="kachel__zeichen">
                  <use href="#instagram-zeichen" />
                </svg>
              </span>
            ))}
          </a>
        )}
      </div>
    </section>
  )
}

<style>
  .unterwegs {
    padding-bottom: 0;
  }

  .unterwegs__innen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-40) var(--space-64);
  }

  .unterwegs__text {
    flex: 1 1 var(--mass-320);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }

  .unterwegs__knopf {
    align-self: flex-start;
    padding-inline: var(--space-24);
  }

  .unterwegs__zeichen {
    width: var(--space-22);
    height: var(--space-22);
  }

  .kacheln {
    flex: 1.4 1 var(--mass-420);
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
  }

  .kachel {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
  }

  .kachel__zeichen {
    width: var(--space-28);
    height: var(--space-28);
  }

  @media (prefers-reduced-motion: no-preference) {
    .kachel {
      transition: opacity 0.2s;
    }
  }

  .kachel:hover {
    opacity: var(--deckkraft-75);
  }

  /* Kachel mit Instagram-Beitrag: Bild füllt das Quadrat, Mitte */
  .kachel--beitrag {
    display: block;
    background: var(--color-papier);
  }

  .kachel--beitrag :global(picture) {
    display: block;
    height: 100%;
  }

  .kachel--beitrag:hover {
    opacity: 1;
  }

  .kachel--beitrag :global(.kachel__bild) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Hover und Fokus: dezente Aufhellung (Fokusrahmen in beere aus global.css) */
  .kachel--beitrag:hover :global(.kachel__bild),
  .kachel--beitrag:focus-visible :global(.kachel__bild) {
    opacity: var(--deckkraft-85);
  }

  @media (prefers-reduced-motion: no-preference) {
    .kachel--beitrag {
      transition: none;
    }

    .kachel--beitrag :global(.kachel__bild) {
      transition: opacity 0.2s;
    }
  }
</style>
