---
/**
 * 04 Partner, gruppiert nach Kategorien. Daten aus src/content/partner.
 * Ohne Logodatei erscheint ein Platzhalter mit dem Partnernamen.
 * Pflichtlogos und Pflichtlinks (pflicht_logo, pflicht_link) werden immer gezeigt bzw. verlinkt.
 */
import { getCollection } from 'astro:content';
import { partnerKategorien } from '../../content.config';
import Torflagge from '../Torflagge.astro';
import EntwurfLabel from '../EntwurfLabel.astro';
import { getText } from '../../lib/inhalte';
import { t, tSchluessel, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = await getText(locale, 'partner');
const partner = await getCollection('partner', (p) => !p.data.beispiel);
const gruppen = partnerKategorien
  .map((kategorie) => ({
    kategorie,
    titel: tSchluessel(locale, `partner.kategorie.${kategorie}`, kategorie),
    partner: partner.filter((p) => p.data.kategorie === kategorie).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge),
  }))
  .filter((g) => g.partner.length > 0);
---

{
  text && (
    <section
      id="partner"
      class="partner flaeche-papier sektion"
      aria-labelledby="partner-titel"
      lang={text.lang !== locale ? text.lang : undefined}
    >
      <div class="partner__innen inhalt">
        <div class="partner__intro sektion-kopf">
          {text.entwurf && <EntwurfLabel locale={locale} />}
          <p class="kicker-flagge t-kicker partner__flagge">{text.data.kicker}</p>
          <h2 id="partner-titel" class="t-titel">
            {text.data.titel}
          </h2>
          <p>{text.data.lead}</p>
        </div>
        <div>
          {gruppen.map((g) => (
            <div class="kategorie">
              <h3 class="kategorie__titel">
                <Torflagge farbe="rosa" breite={10} hoehe={24} />
                {g.titel}
              </h3>
              <ul role="list" class:list={['kategorie__logos', `kategorie__logos--${g.kategorie}`]}>
                {g.partner.map((p, i) => {
                  const hoehe = `--logo-hoehe: var(--space-${p.data.logo_hoehe}, var(--mass-${p.data.logo_hoehe}))`;
                  const inhalt =
                    p.data.darstellung === 'text' ? (
                      <span class="partner-text" style={hoehe}>{p.data.name}</span>
                    ) : p.data.logo ? (
                      <img class="partner-logo" src={p.data.logo} alt={p.data.name} style={hoehe} loading="lazy" decoding="async" />
                    ) : (
                      <span class="logo-platzhalter" style={hoehe} title={t(locale, 'partner.logo_folgt')}>
                        <span class="t-label">{p.data.name}</span>
                      </span>
                    );
                  return (
                    <li class:list={['partner-eintrag', `partner-eintrag--${(i % 3) + 1}`]}>
                      {p.data.url ? (
                        <a class="partner-link" href={p.data.url} target="_blank" rel="noopener">
                          {inhalt}
                          <span class="visually-hidden">{t(locale, 'link.neues_fenster')}</span>
                        </a>
                      ) : (
                        inhalt
                      )}
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .partner {
    border-top: var(--linie-1) solid var(--color-linie-soft);
  }

  .partner__innen {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }

  .partner__intro {
    max-width: var(--mass-760);
  }

  .kategorie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-24) var(--space-48);
    padding-block: var(--space-40);
    border-top: var(--linie-1) solid var(--color-linie-soft);
  }

  .kategorie__titel {
    flex: 0 1 var(--mass-260);
    min-width: 0;
    /* Trennung nur an den weichen Trennstrichen in src/i18n (z. B. Trinkflaschen-partner) */
    hyphens: manual;
    display: inline-flex;
    align-items: center;
    gap: var(--space-12);
    font-size: var(--size-28);
    line-height: var(--line-100);
    letter-spacing: var(--track-04);
    text-transform: uppercase;
    color: var(--color-tinte);
  }

  .kategorie__logos {
    flex: 1 1 var(--mass-480);
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-32) var(--space-64);
  }

  .kategorie__logos--kopfsponsoren {
    column-gap: var(--space-96);
  }

  .partner-link {
    display: inline-flex;
    align-items: center;
    padding-block: var(--space-8);
    color: var(--color-tinte);
    text-decoration: none;
  }

  .partner-logo {
    height: var(--logo-hoehe);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .logo-platzhalter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    height: var(--logo-hoehe);
    padding-inline: var(--space-24);
    background: var(--color-hauch-2);
    color: var(--color-tinte-soft);
    text-align: center;
  }

  .partner-text {
    display: inline-flex;
    align-items: center;
    width: min-content;
    height: var(--logo-hoehe);
    font-family: var(--font-display);
    font-size: var(--size-30);
    font-weight: var(--weight-700);
    line-height: var(--line-100);
    text-transform: uppercase;
    color: var(--color-tinte);
  }

  @media (prefers-reduced-motion: no-preference) {
    .partner-logo,
    .logo-platzhalter {
      transition: transform 0.25s ease;
    }

    .partner-link:hover .partner-logo,
    .partner-link:hover .logo-platzhalter {
      transform: translateY(calc(-1 * var(--space-4))) scale(1.04);
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      @keyframes logo-rein {
        from {
          opacity: 0;
          transform: translateY(var(--space-36)) scale(0.96);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      @keyframes titel-rein {
        from {
          opacity: 0;
          transform: translateX(calc(-1 * var(--space-24)));
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      @keyframes flagge-rein {
        from {
          opacity: 0;
          transform: translateX(calc(-1 * var(--space-40)));
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      .partner-eintrag {
        animation: logo-rein linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 28%;
      }

      .partner-eintrag--2 {
        animation-range: entry 12% cover 34%;
      }

      .partner-eintrag--3 {
        animation-range: entry 24% cover 40%;
      }

      .kategorie__titel {
        animation: titel-rein linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 22%;
      }

      .partner__flagge {
        animation: flagge-rein linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 25%;
      }
    }
  }
</style>
