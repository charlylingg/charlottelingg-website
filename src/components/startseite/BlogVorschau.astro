---
/**
 * Blog: Vorschau der Beiträge. Jeder veröffentlichte Beitrag hat eine eigene Seite /blog/<slug>.
 * Beiträge mit Status «folgt» erscheinen nur als Vorschau mit «Beitrag folgt».
 */
import Torflagge from '../Torflagge.astro';
import Bildplatzhalter from '../Bildplatzhalter.astro';
import EntwurfLabel from '../EntwurfLabel.astro';
import { getBlog, getText } from '../../lib/inhalte';
import { blogDatum } from '../../lib/format';
import { localizePath, t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = await getText(locale, 'blog');
const beitraege = (await getBlog(locale)).map((b) => {
  const datum = blogDatum(b.data.datum, b.lang);
  const ortUndDatum = [b.data.ort, datum].filter(Boolean).join(', ');
  return {
    ...b,
    zeile: [b.data.kategorie, ortUndDatum].filter(Boolean).join(' · '),
    href: localizePath(`/blog/${b.slug}/`, locale),
  };
});
---

{
  text && beitraege.length > 0 && (
    <section
      id="blog"
      class="blog flaeche-papier sektion"
      aria-labelledby="blog-titel"
      lang={text.lang !== locale ? text.lang : undefined}
    >
      <div class="blog__innen inhalt">
        {text.entwurf && <EntwurfLabel locale={locale} />}
        <h2 id="blog-titel" class="blog__titel">
          <Torflagge farbe="rosa" breite={12} hoehe={34} />
          {text.data.titel}
        </h2>
        <ul role="list" class="blog__liste">
          {beitraege.map((b) => (
            <li>
              <article class="karte" lang={b.lang !== locale ? b.lang : undefined}>
                {b.data.bild ? (
                  <Bildplatzhalter stelle={`Blog «${b.data.titel}»`} format="Querformat 16:10" verhaeltnis="16 / 10" alt={b.data.bild_alt} />
                ) : (
                  <div class="karte__grafik" aria-hidden="true">
                    <span class="karte__flagge karte__flagge--beere" />
                    <span class="karte__flagge karte__flagge--rosa" />
                  </div>
                )}
                {b.entwurf && <EntwurfLabel locale={locale} />}
                <p class="karte__zeile">{b.zeile}</p>
                <h3 class="karte__titel">
                  {b.data.status === 'veroeffentlicht' ? (
                    <a class="karte__link" href={b.href}>
                      {b.data.titel}
                    </a>
                  ) : (
                    b.data.titel
                  )}
                </h3>
                <p class="karte__teaser">{b.data.teaser}</p>
                {b.data.status === 'veroeffentlicht' ? (
                  <span class="karte__weiter t-mehr" aria-hidden="true">
                    {t(locale, 'blog.weiterlesen')}
                    <span class="aufklapp-zeichen">→</span>
                  </span>
                ) : (
                  <p class="karte__folgt">{t(locale, 'blog.folgt')}</p>
                )}
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .blog {
    padding-top: var(--space-72);
  }

  .blog__innen {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }

  .blog__titel {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    font-size: var(--size-44);
    text-transform: uppercase;
  }

  .blog__liste {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--mass-280)), 1fr));
    gap: var(--space-40) var(--space-32);
  }

  .karte {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-14);
  }

  .karte__grafik {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-14);
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--color-aubergine);
  }

  .karte__flagge {
    display: block;
    width: var(--space-22);
    height: var(--space-64);
    transform: skewX(var(--schraege));
  }

  .karte__flagge--beere {
    background: var(--color-beere);
    outline: var(--linie-2) solid var(--color-papier);
  }

  .karte__flagge--rosa {
    background: var(--color-rosa);
  }

  .karte__zeile {
    font-family: var(--font-display);
    font-size: var(--size-14);
    font-weight: var(--weight-600);
    letter-spacing: var(--track-14);
    text-transform: uppercase;
    color: var(--color-rosa);
  }

  .karte__titel {
    font-size: var(--size-28);
    line-height: var(--line-105);
    text-transform: uppercase;
  }

  .karte__link {
    color: var(--color-tinte);
    text-decoration: none;
  }

  /* Ganze Karte klickbar, Link bleibt der Titel */
  .karte__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .karte__link:hover,
  .karte__link:focus-visible {
    color: var(--color-tinte);
    text-decoration: underline;
  }

  .karte__teaser {
    color: var(--color-tinte-soft);
  }

  .karte__weiter {
    display: inline-flex;
    align-items: center;
    gap: var(--space-10);
    padding-block: var(--space-8);
    color: var(--color-beere);
  }

  .karte__folgt {
    padding-block: var(--space-8);
    font-family: var(--font-display);
    font-size: var(--size-16);
    font-weight: var(--weight-600);
    letter-spacing: var(--track-06);
    text-transform: uppercase;
    color: var(--color-tinte-soft);
  }
</style>
