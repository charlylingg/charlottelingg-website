---
/**
 * 02 Resultate: Podest Europacup (Ränge 1–3) und Höhepunkte aus Weltcup und WM.
 * Daten aus src/content/resultate, Texte aus src/content/texte/<sprache>/resultate.md.
 */
import { getCollection } from 'astro:content';
import Torflagge from '../Torflagge.astro';
import EntwurfLabel from '../EntwurfLabel.astro';
import { getText, istPlatzhalter } from '../../lib/inhalte';
import { t, tSchluessel, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = await getText(locale, 'resultate');
const resultate = await getCollection('resultate', (r) => !r.data.beispiel);

const nachOrt = (a: (typeof resultate)[number], b: (typeof resultate)[number]) =>
  a.data.ort.localeCompare(b.data.ort, 'de');

/** Podest in der Reihenfolge des Designs: 2. links, 1. Mitte, 3. rechts */
const podest = [2, 1, 3].map((rang) => ({
  rang,
  rennen: resultate.filter((r) => r.data.stufe === 'Europacup' && r.data.rang === rang).sort(nachOrt),
}));

const stufenReihenfolge = ['Weltcup', 'WM'];
const hoehepunkte = resultate
  .filter((r) => stufenReihenfolge.includes(r.data.stufe))
  .sort((a, b) => stufenReihenfolge.indexOf(a.data.stufe) - stufenReihenfolge.indexOf(b.data.stufe) || nachOrt(a, b))
  .map((r) => ({
    rang: typeof r.data.rang === 'number' ? `${r.data.rang}.` : r.data.rang,
    zeile1: [
      tSchluessel(locale, `stufe.${r.data.stufe}`, r.data.stufe),
      istPlatzhalter(r.data.disziplin) ? undefined : tSchluessel(locale, `disziplin.${r.data.disziplin}`, r.data.disziplin),
    ]
      .filter(Boolean)
      .join(' '),
    zeile2: r.data.ort,
  }));

const disziplinName = (d: string) => (istPlatzhalter(d) ? undefined : tSchluessel(locale, `disziplin.${d}`, d));
const farbeVonRang: Record<number, string> = { 1: 'red', 2: 'navy', 3: 'nacht' };
---

{
  text && (
    <section
      id="resultate"
      class="resultate flaeche-paper sektion"
      aria-labelledby="resultate-titel"
      lang={text.lang !== locale ? text.lang : undefined}
    >
      <div class="resultate__innen inhalt">
        <div class="resultate__kopf">
          <div class="resultate__intro">
            {text.entwurf && <EntwurfLabel locale={locale} />}
            <p class="kicker-flagge kicker-flagge--rot t-kicker">{text.data.kicker}</p>
            <h2 id="resultate-titel" class="t-titel">
              {text.data.titel}
            </h2>
            <p class="resultate__lead">{text.data.lead}</p>
          </div>
          <div class="resultate__links">
            <a class="textlink t-display-s" href={text.data.fis_profil.url} target="_blank" rel="noopener">
              {text.data.fis_profil.text}
              <span class="visually-hidden">{t(locale, 'link.neues_fenster')}</span>
            </a>
            <a class="kalender-link flaeche-eis" href="#rennen">
              <span class="t-label kalender-link__label">{text.data.kalender.label}</span>
              <span class="t-display-s">{text.data.kalender.text}</span>
            </a>
          </div>
        </div>

        <div class="podium-block">
          <h3 class="podium-titel t-display-l">
            <Torflagge farbe="navy" groesse="klein" />
            {text.data.podium_titel}
            <Torflagge farbe="red" groesse="klein" />
          </h3>
          <ul role="list" class="podium">
            {podest.map((stufe) => (
              <li class:list={['podium__platz', `podium__platz--${stufe.rang}`]}>
                <svg class="medaille" aria-hidden="true" viewBox="0 0 100 150">
                  <path d="M28 0 L50 58 L38 62 L14 0 Z" fill="var(--color-navy)" />
                  <path d="M72 0 L50 58 L62 62 L86 0 Z" fill="var(--color-red)" />
                  <circle cx="50" cy="100" r="40" fill="var(--color-eis)" stroke={`var(--color-${farbeVonRang[stufe.rang]})`} stroke-width="4" />
                  <circle cx="50" cy="100" r="30" fill="none" stroke="var(--color-line)" stroke-width="2" />
                  <text
                    x="50"
                    y="112"
                    text-anchor="middle"
                    font-family="Barlow Condensed, Arial Narrow, sans-serif"
                    font-weight="700"
                    font-size="34"
                    fill={`var(--color-${farbeVonRang[stufe.rang]})`}
                  >
                    {stufe.rang}
                  </text>
                </svg>
                <p class="visually-hidden">
                  {t(locale, 'resultate.platz')} {stufe.rang}
                </p>
                <ul role="list" class="podium__rennen">
                  {stufe.rennen.map((r) => (
                    <li>
                      <strong class="t-display-s">{r.data.ort}</strong>{' '}
                      {disziplinName(r.data.disziplin) && <span class="t-klein">{disziplinName(r.data.disziplin)}</span>}
                    </li>
                  ))}
                </ul>
                <div class="podium__sockel" aria-hidden="true">
                  <span class="t-zahl">{stufe.rang}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <ul role="list" class="hoehepunkte">
          {hoehepunkte.map((h, i) => (
            <li class="hoehepunkt">
              <span class:list={['hoehepunkt__zahl', i % 2 === 1 && 'hoehepunkt__zahl--rot']}>{h.rang}</span>
              <span class="t-display-s hoehepunkt__text">
                {h.zeile1}
                <br />
                {h.zeile2}
              </span>
            </li>
          ))}
          <li class="hoehepunkt">
            <span class="hoehepunkt__zahl">{text.data.fis_zusatz.wert}</span>
            <span class="t-display-s hoehepunkt__text">
              {text.data.fis_zusatz.zeilen.map((zeile, i) => (
                <>
                  {i > 0 && <br />}
                  {zeile}
                </>
              ))}
            </span>
          </li>
        </ul>
      </div>
    </section>
  )
}

<style>
  .resultate__innen {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .resultate__kopf {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-3);
  }

  .resultate__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 640px;
  }

  .resultate__lead {
    color: var(--color-ink-soft);
  }

  .resultate__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    flex: 0 1 320px;
  }

  .kalender-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
    color: var(--color-ink);
    text-decoration: none;
  }

  .kalender-link:hover .t-display-s {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .kalender-link__label {
    color: var(--color-ink-soft);
  }

  /* Podest */
  .podium-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .podium-titel {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .podium {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: end;
    width: 100%;
    max-width: 900px;
    border-bottom: var(--space-1) solid var(--color-nacht);
  }

  .podium__platz {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-2);
    min-width: 0;
    padding-inline: var(--space-1);
  }

  .medaille {
    width: calc(var(--space-4) + var(--space-3));
    height: auto;
    overflow: visible;
  }

  .podium__rennen {
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-1) / 2);
    text-align: center;
  }

  .podium__rennen strong {
    display: block;
  }

  .podium__rennen .t-klein {
    color: var(--color-ink-soft);
  }

  .podium__sockel {
    display: flex;
    justify-content: center;
    width: 100%;
    padding-top: var(--space-2);
    color: var(--color-paper);
    clip-path: polygon(6% 0, 94% 0, 100% 100%, 0 100%);
  }

  .podium__platz--1 .podium__sockel {
    height: 220px;
    background: var(--color-red);
  }

  .podium__platz--2 .podium__sockel {
    height: 150px;
    background: var(--color-navy);
  }

  .podium__platz--3 .podium__sockel {
    height: 100px;
    background: var(--color-nacht);
  }

  @media (max-width: 640px) {
    .podium__platz--1 .podium__sockel {
      height: 160px;
    }

    .podium__platz--2 .podium__sockel {
      height: 110px;
    }

    .podium__platz--3 .podium__sockel {
      height: 80px;
    }

    .podium__sockel .t-zahl {
      font-size: var(--type-titel-size);
    }

    .medaille {
      width: var(--space-4);
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      @keyframes sockel-hoch {
        from {
          transform: scaleY(0);
        }
        to {
          transform: none;
        }
      }

      .podium__sockel {
        transform-origin: 50% 100%;
        animation: sockel-hoch linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 30%;
      }

      .podium__platz--1 .podium__sockel {
        animation-range: entry 10% cover 38%;
      }

      .podium__platz--3 .podium__sockel {
        animation-range: entry 20% cover 44%;
      }
    }
  }

  /* Höhepunkte */
  .hoehepunkte {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) calc(var(--space-4) + var(--space-3));
    padding-top: var(--space-1);
  }

  .hoehepunkt {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .hoehepunkt__zahl {
    font-family: var(--font-display);
    font-size: var(--type-titel-size);
    line-height: var(--type-abschnitt-line);
    font-weight: 700;
    color: var(--color-navy);
  }

  .hoehepunkt__zahl--rot {
    color: var(--color-red);
  }
</style>
