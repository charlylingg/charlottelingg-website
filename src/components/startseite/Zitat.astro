---
import Torflagge from '../Torflagge.astro';
import EntwurfLabel from '../EntwurfLabel.astro';
import { getText } from '../../lib/inhalte';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = await getText(locale, 'zitat');
---

{
  text && (
    <section
      class="zitat flaeche-aubergine"
      aria-label={t(locale, 'zitat.label')}
      lang={text.lang !== locale ? text.lang : undefined}
    >
      <div class="zitat__innen inhalt">
        <Torflagge farbe="rosa" breite={28} hoehe={88} />
        <figure class="zitat__figur">
          {text.entwurf && <EntwurfLabel locale={locale} />}
          <blockquote class="t-zitat zitat__text">
            <p>{text.data.zitat}</p>
          </blockquote>
          <figcaption class="zitat__autor">{text.data.autor}</figcaption>
        </figure>
      </div>
    </section>
  )
}

<style>
  .zitat {
    padding-block: var(--space-96);
  }

  .zitat__innen {
    display: flex;
    align-items: flex-start;
    gap: var(--space-32);
  }

  .zitat__figur {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    min-width: 0;
  }

  .zitat__text {
    max-width: var(--mass-900);
  }

  .zitat__autor {
    font-size: var(--size-13);
    letter-spacing: var(--track-14);
    text-transform: uppercase;
  }
</style>
