---
/**
 * Kontakt mit Formular. Versand über den Worker (POST /api/kontakt, siehe worker/kontakt.ts).
 * Mit JavaScript wird per fetch gesendet, ohne JavaScript als normaler Post; der Worker leitet dann
 * zurück auf /?gesendet=1#kontakt-gesendet bzw. /?fehler=1#kontakt-fehler, die Meldung erscheint über :target.
 * Fehlermeldungen der Felder erscheinen ohne JavaScript, sobald ein Feld nach der Eingabe ungültig ist (:user-invalid).
 * Spam-Schutz: Honeypot-Feld «website» (für Menschen unsichtbar) und Feld «zeit» (Zeitstempel beim Laden, per JavaScript).
 * Die Prüfungen (Pflichtfelder, Längen) entsprechen denen im Worker.
 */
import EntwurfLabel from '../EntwurfLabel.astro';
import { getText } from '../../lib/inhalte';
import { localizePath, t, type Locale } from '../../i18n';
import { EMAIL_KONTAKT } from '../../config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = await getText(locale, 'kontakt');
const anliegen = (['sponsoring', 'medien', 'anlass', 'allgemein'] as const).map((a) => ({
  wert: a,
  text: t(locale, `form.anliegen.${a}`),
}));
/** Text mit Platzhalter {name} in den Teil davor und danach zerlegen */
const teile = (text: string, name: string) => {
  const [vor = '', nach = ''] = text.split(`{${name}}`);
  return { vor, nach };
};
const direkt = teile(t(locale, 'form.direkt'), 'email');
const fehlerSenden = teile(t(locale, 'form.fehler.senden'), 'email');
const datenschutz = teile(t(locale, 'form.datenschutz'), 'link');
const mailto = `mailto:${EMAIL_KONTAKT}`;
---

{
  text && (
    <section
      id="kontakt"
      class="kontakt flaeche-aubergine"
      aria-labelledby="kontakt-titel"
      lang={text.lang !== locale ? text.lang : undefined}
    >
      <div class="kontakt__innen inhalt">
        <div class="kontakt__text">
          {text.entwurf && <EntwurfLabel locale={locale} />}
          <h2 id="kontakt-titel" class="t-titel">
            {text.data.titel}
          </h2>
          <p class="kontakt__einleitung">{text.data.text}</p>
        </div>

        <form
          class="formular"
          aria-label={t(locale, 'form.label')}
          lang={locale}
          action="/api/kontakt"
          method="post"
          data-kontakt-formular
        >
          <p class="formular__legende">{t(locale, 'form.pflicht_legende')}</p>
          <div class="formular__reihe">
            <div class="feld">
              <label for="kontakt-name">
                {t(locale, 'form.name')} <span aria-hidden="true">*</span>
              </label>
              <input
                id="kontakt-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                maxlength="100"
                aria-describedby="kontakt-name-fehler"
              />
              <p id="kontakt-name-fehler" class="feld__fehler">
                {t(locale, 'form.fehler.name')}
              </p>
            </div>
            <div class="feld">
              <label for="kontakt-email">
                {t(locale, 'form.email')} <span aria-hidden="true">*</span>
              </label>
              <input
                id="kontakt-email"
                name="email"
                type="email"
                autocomplete="email"
                inputmode="email"
                required
                maxlength="200"
                aria-describedby="kontakt-email-fehler"
              />
              <p id="kontakt-email-fehler" class="feld__fehler">
                {t(locale, 'form.fehler.email')}
              </p>
            </div>
          </div>
          <div class="feld">
            <label for="kontakt-anliegen">
              {t(locale, 'form.anliegen')} <span aria-hidden="true">*</span>
            </label>
            <select id="kontakt-anliegen" name="anliegen" required>
              {anliegen.map((a) => (
                <option value={a.wert}>{a.text}</option>
              ))}
            </select>
          </div>
          <div class="feld">
            <label for="kontakt-nachricht">
              {t(locale, 'form.nachricht')} <span aria-hidden="true">*</span>
            </label>
            <textarea
              id="kontakt-nachricht"
              name="nachricht"
              rows="4"
              required
              minlength="10"
              maxlength="5000"
              aria-describedby="kontakt-nachricht-fehler"
            />
            <p id="kontakt-nachricht-fehler" class="feld__fehler">
              {t(locale, 'form.fehler.nachricht')}
            </p>
          </div>

          <div class="feld visually-hidden" aria-hidden="true">
            <label for="kontakt-website">{t(locale, 'form.honeypot')}</label>
            <input id="kontakt-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="sprache" value={locale} />
          <input type="hidden" name="zeit" value="" />

          <div class="formular__senden">
            <button
              class="knopf knopf--beere t-knopf formular__knopf"
              type="submit"
              data-text-senden={t(locale, 'form.senden')}
              data-text-laeuft={t(locale, 'form.senden_laeuft')}
            >
              {t(locale, 'form.senden')}
            </button>
            <p class="formular__hinweis">
              {direkt.vor}<a href={mailto}>{EMAIL_KONTAKT}</a>{direkt.nach}
            </p>
          </div>

          <div class="formular__meldungen" aria-live="polite">
            <p id="kontakt-gesendet" class="formular__meldung" tabindex="-1">
              {t(locale, 'form.gesendet')}
            </p>
            <p id="kontakt-fehler" class="formular__meldung" tabindex="-1">
              {fehlerSenden.vor}<a href={mailto}>{EMAIL_KONTAKT}</a>{fehlerSenden.nach}
            </p>
          </div>

          <p class="formular__datenschutz">
            {datenschutz.vor}<a href={localizePath('/datenschutz/', locale)}>{t(locale, 'form.datenschutz_link')}</a>{datenschutz.nach}
          </p>
        </form>
      </div>
    </section>
  )
}

<style>
  .kontakt {
    padding-block: var(--space-88) var(--space-40);
  }

  .kontakt__innen {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-56);
  }

  .kontakt__text {
    flex: 1 1 var(--mass-320);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }

  .kontakt__einleitung {
    max-width: var(--mass-26rem);
    font-size: var(--size-18);
    line-height: var(--line-150);
  }

  .formular {
    flex: 1.4 1 var(--mass-420);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .formular__legende {
    font-size: var(--size-14);
  }

  .formular__reihe {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--mass-200)), 1fr));
    gap: var(--space-16);
  }

  .feld {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    font-size: var(--size-14);
  }

  /* 17px wie im Design (mind. 16px, sonst zoomt das iPhone beim Antippen) */
  .feld input,
  .feld select,
  .feld textarea {
    width: 100%;
    min-height: var(--space-48);
    padding: 0 var(--space-14);
    border: var(--linie-1) solid var(--color-linie);
    background: var(--color-papier);
    color: var(--color-tinte);
    font-size: var(--size-17);
  }

  .feld textarea {
    padding-block: var(--space-12);
    resize: vertical;
  }

  .feld input:focus-visible,
  .feld select:focus-visible,
  .feld textarea:focus-visible {
    outline: var(--fokus) solid var(--color-rosa);
    outline-offset: var(--space-2);
  }

  /* Fehlermeldung erst nach einer ungültigen Eingabe zeigen */
  .feld__fehler {
    display: none;
    padding-left: var(--space-8);
    border-left: var(--linie-6) solid var(--color-rosa);
  }

  .feld:has(:user-invalid) .feld__fehler {
    display: block;
  }

  .feld:has(:user-invalid) :is(input, textarea) {
    border-color: var(--color-rosa);
    outline: var(--linie-2) solid var(--color-rosa);
    outline-offset: 0;
  }

  .formular__senden {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12) var(--space-24);
  }

  .formular__knopf {
    align-self: flex-start;
    padding-inline: var(--space-28);
  }

  /* Hover/Fokus wie die übrigen Buttons auf aubergine Flächen */
  .formular__knopf:not(:disabled):hover,
  .formular__knopf:not(:disabled):focus-visible {
    background: var(--color-aubergine);
    color: var(--color-papier);
    outline: var(--linie-2) solid var(--color-papier);
    outline-offset: calc(-1 * var(--space-4));
  }

  /* Während des Sendens deaktiviert: helle Fläche, Schrift bleibt lesbar (5.9:1) */
  .formular__knopf:disabled {
    background: var(--color-hauch-2);
    color: var(--color-tinte-soft);
    cursor: not-allowed;
  }

  .formular__hinweis,
  .formular__datenschutz {
    font-size: var(--size-14);
  }

  .formular__hinweis a,
  .formular__meldung a {
    overflow-wrap: anywhere;
  }

  /* Meldung nach dem Senden: mit JavaScript über die Klasse, ohne JavaScript über den Anker (:target) */
  .formular__meldung {
    display: none;
    padding-left: var(--space-8);
    border-left: var(--linie-6) solid var(--color-rosa);
    /* Anker-Sprung (ohne JavaScript) landet unter dem fixierten Kopf */
    scroll-margin-top: var(--space-92);
  }

  .formular__meldung:target,
  .formular__meldung.ist-sichtbar {
    display: block;
  }

  .formular__meldung:focus {
    outline: none;
  }

  .formular__meldung:focus-visible {
    outline: var(--fokus) solid var(--color-papier);
    outline-offset: var(--space-2);
  }
</style>

<script>
  /**
   * Progressive Verbesserung: Senden per fetch, Meldung in der aria-live-Region, Fokus auf die Meldung.
   * Ohne JavaScript funktioniert das Formular als normaler Post (der Worker leitet zurück).
   */
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-kontakt-formular]')) {
    const zeit = form.querySelector<HTMLInputElement>('input[name="zeit"]');
    const knopf = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const gesendet = form.querySelector<HTMLElement>('#kontakt-gesendet');
    const fehler = form.querySelector<HTMLElement>('#kontakt-fehler');
    const zeitSetzen = () => {
      if (zeit) zeit.value = String(Date.now());
    };
    zeitSetzen();

    const zeigen = (meldung: HTMLElement | null) => {
      for (const m of [gesendet, fehler]) m?.classList.toggle('ist-sichtbar', m === meldung);
      meldung?.focus();
    };

    // Rückkehr nach einem Post ohne fetch: Meldung zeigen, Adresse aufräumen
    const parameter = new URLSearchParams(location.search);
    if (parameter.has('gesendet') || parameter.has('fehler')) {
      zeigen(parameter.has('gesendet') ? gesendet : fehler);
      history.replaceState(null, '', location.pathname + '#kontakt');
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!knopf || knopf.disabled) return;
      zeigen(null);
      knopf.disabled = true;
      knopf.textContent = knopf.dataset.textLaeuft ?? '';
      let ok = false;
      try {
        const antwort = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const daten = (await antwort.json()) as { ok?: boolean };
        ok = antwort.ok && daten.ok === true;
      } catch {
        ok = false;
      }
      knopf.disabled = false;
      knopf.textContent = knopf.dataset.textSenden ?? '';
      if (ok) {
        form.reset();
        zeitSetzen();
      }
      zeigen(ok ? gesendet : fehler);
    });
  }
</script>
