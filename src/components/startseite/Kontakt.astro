---
/**
 * Kontakt mit Formular – nur die Oberfläche. Der Versand folgt in einem eigenen Auftrag.
 * Bis dahin ist der Senden-Knopf deaktiviert. Das Formular wird nirgends hingeschickt.
 * Fehlermeldungen erscheinen ohne JavaScript, sobald ein Feld nach der Eingabe ungültig ist (:user-invalid).
 * Honeypot-Feld «website» ist für Menschen unsichtbar (visually-hidden, Spam-Schutz für später).
 */
import EntwurfLabel from '../EntwurfLabel.astro';
import { getText } from '../../lib/inhalte';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = await getText(locale, 'kontakt');
const anliegen = (['sponsoring', 'medien', 'anlass', 'allgemein'] as const).map((a) => t(locale, `form.anliegen.${a}`));
---

{
  text && (
    <section
      id="kontakt"
      class="kontakt flaeche-aubergine"
      aria-labelledby="kontakt-titel"
      lang={text.lang !== locale ? text.lang : undefined}
    >
      <div class="kontakt__innen inhalt">
        <div class="kontakt__text">
          {text.entwurf && <EntwurfLabel locale={locale} />}
          <h2 id="kontakt-titel" class="t-titel">
            {text.data.titel}
          </h2>
          <p class="kontakt__einleitung">{text.data.text}</p>
        </div>

        <form class="formular" aria-label={t(locale, 'form.label')} lang={locale}>
          <p class="formular__legende">{t(locale, 'form.pflicht_legende')}</p>
          <div class="formular__reihe">
            <div class="feld">
              <label for="kontakt-name">
                {t(locale, 'form.name')} <span aria-hidden="true">*</span>
              </label>
              <input
                id="kontakt-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                aria-describedby="kontakt-name-fehler"
              />
              <p id="kontakt-name-fehler" class="feld__fehler">
                {t(locale, 'form.fehler.name')}
              </p>
            </div>
            <div class="feld">
              <label for="kontakt-email">
                {t(locale, 'form.email')} <span aria-hidden="true">*</span>
              </label>
              <input
                id="kontakt-email"
                name="email"
                type="email"
                autocomplete="email"
                inputmode="email"
                required
                aria-describedby="kontakt-email-fehler"
              />
              <p id="kontakt-email-fehler" class="feld__fehler">
                {t(locale, 'form.fehler.email')}
              </p>
            </div>
          </div>
          <div class="feld">
            <label for="kontakt-anliegen">
              {t(locale, 'form.anliegen')} <span aria-hidden="true">*</span>
            </label>
            <select id="kontakt-anliegen" name="anliegen" required>
              {anliegen.map((a) => (
                <option>{a}</option>
              ))}
            </select>
          </div>
          <div class="feld">
            <label for="kontakt-nachricht">
              {t(locale, 'form.nachricht')} <span aria-hidden="true">*</span>
            </label>
            <textarea id="kontakt-nachricht" name="nachricht" rows="4" required aria-describedby="kontakt-nachricht-fehler" />
            <p id="kontakt-nachricht-fehler" class="feld__fehler">
              {t(locale, 'form.fehler.nachricht')}
            </p>
          </div>

          <div class="feld visually-hidden" aria-hidden="true">
            <label for="kontakt-website">{t(locale, 'form.honeypot')}</label>
            <input id="kontakt-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="formular__senden">
            <button class="knopf knopf--beere t-knopf formular__knopf" type="submit" disabled aria-describedby="kontakt-inaktiv">
              {t(locale, 'form.senden')}
            </button>
            <p id="kontakt-inaktiv" class="formular__hinweis">
              {t(locale, 'form.inaktiv')}
            </p>
          </div>
        </form>
      </div>
    </section>
  )
}

<style>
  .kontakt {
    padding-block: var(--space-88) var(--space-40);
  }

  .kontakt__innen {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-56);
  }

  .kontakt__text {
    flex: 1 1 var(--mass-320);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }

  .kontakt__einleitung {
    max-width: var(--mass-26rem);
    font-size: var(--size-18);
    line-height: var(--line-150);
  }

  .formular {
    flex: 1.4 1 var(--mass-420);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .formular__legende {
    font-size: var(--size-14);
  }

  .formular__reihe {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--mass-200)), 1fr));
    gap: var(--space-16);
  }

  .feld {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    font-size: var(--size-14);
  }

  /* 17px wie im Design (mind. 16px, sonst zoomt das iPhone beim Antippen) */
  .feld input,
  .feld select,
  .feld textarea {
    width: 100%;
    min-height: var(--space-48);
    padding: 0 var(--space-14);
    border: var(--linie-1) solid var(--color-linie);
    background: var(--color-papier);
    color: var(--color-tinte);
    font-size: var(--size-17);
  }

  .feld textarea {
    padding-block: var(--space-12);
    resize: vertical;
  }

  .feld input:focus-visible,
  .feld select:focus-visible,
  .feld textarea:focus-visible {
    outline: var(--fokus) solid var(--color-rosa);
    outline-offset: var(--space-2);
  }

  /* Fehlermeldung erst nach einer ungültigen Eingabe zeigen */
  .feld__fehler {
    display: none;
    padding-left: var(--space-8);
    border-left: var(--linie-6) solid var(--color-rosa);
  }

  .feld:has(:user-invalid) .feld__fehler {
    display: block;
  }

  .feld:has(:user-invalid) :is(input, textarea) {
    border-color: var(--color-rosa);
    outline: var(--linie-2) solid var(--color-rosa);
    outline-offset: 0;
  }

  .formular__senden {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12) var(--space-24);
  }

  .formular__knopf {
    align-self: flex-start;
    padding-inline: var(--space-28);
  }

  /* Deaktiviert, bis der Versand gebaut ist: helle Fläche, Schrift bleibt lesbar (5.9:1) */
  .formular__knopf:disabled {
    background: var(--color-hauch-2);
    color: var(--color-tinte-soft);
    cursor: not-allowed;
  }

  .formular__hinweis {
    font-size: var(--size-14);
  }
</style>
