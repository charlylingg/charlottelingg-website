---
/**
 * 03 Mein Weg: Stationen als Slalomkurs und aufklappbar «Meine ganze Geschichte».
 * Texte aus src/content/texte/<sprache>/weg.md und dem Ordner weg/ (eine Datei pro Station bzw. Teil).
 */
import { getCollection, render } from 'astro:content';
import Torflagge from '../Torflagge.astro';
import EntwurfLabel from '../EntwurfLabel.astro';
import { getText, getTexteListe, istPlatzhalter } from '../../lib/inhalte';
import { tSchluessel, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = await getText(locale, 'weg');
const stationen = await getTexteListe(locale, 'weg-station');
const teile = await Promise.all(
  (await getTexteListe(locale, 'weg-geschichte')).map(async (teil) => ({
    ...teil,
    Inhalt: (await render(teil.eintrag)).Content,
  })),
);

/** Liste «Meine schönsten Resultate»: aus src/content/resultate (Europacup, dann Weltcup, dann WM; je nach Rang) */
const stufenReihenfolge = ['Europacup', 'Weltcup', 'WM'];
const resultate = (await getCollection('resultate', (r) => !r.data.beispiel))
  .filter((r) => stufenReihenfolge.includes(r.data.stufe))
  .sort(
    (a, b) =>
      stufenReihenfolge.indexOf(a.data.stufe) - stufenReihenfolge.indexOf(b.data.stufe) ||
      Number(a.data.rang) - Number(b.data.rang) ||
      a.data.ort.localeCompare(b.data.ort, 'de'),
  )
  .map((r) => {
    const disziplin = istPlatzhalter(r.data.disziplin)
      ? undefined
      : tSchluessel(locale, `disziplin.${r.data.disziplin}`, r.data.disziplin);
    const stufe = tSchluessel(locale, `stufe.${r.data.stufe}`, r.data.stufe);
    const stufeKurz = tSchluessel(locale, `stufe_kurz.${r.data.stufe}`, stufe);
    return {
      rang: typeof r.data.rang === 'number' ? `${r.data.rang}.` : r.data.rang,
      podest: typeof r.data.rang === 'number' && r.data.rang === 1,
      fett: disziplin ?? stufeKurz,
      rest: [disziplin ? stufe : undefined, r.data.ort].filter(Boolean).join(' '),
      land: istPlatzhalter(r.data.land) ? undefined : r.data.land,
    };
  });

/** Höhe einer Kurs-Reihe auf dem Desktop; die Kurslinie wird daran ausgerichtet */
const REIHE = 220;
const kursHoehe = stationen.length * REIHE;
---

{
  text && (
    <section
      id="weg"
      class="weg flaeche-eis sektion"
      aria-labelledby="weg-titel"
      lang={text.lang !== locale ? text.lang : undefined}
    >
      <div class="weg__innen inhalt">
        <div class="weg__intro">
          {text.entwurf && <EntwurfLabel locale={locale} />}
          <p class="kicker-flagge t-kicker">{text.data.kicker}</p>
          <h2 id="weg-titel" class="t-titel">
            {text.data.titel}
          </h2>
        </div>

        <div class="kurs" style={`--reihe: ${REIHE}px`}>
          <svg
            class="kurs__linie"
            aria-hidden="true"
            viewBox={`0 0 200 ${kursHoehe}`}
            preserveAspectRatio="none"
            style={`height: ${kursHoehe}px`}
          >
            <path
              d={`M100 0 C100 60 40 60 40 110 ${stationen
                .slice(1)
                .map((_, i) => `S${i % 2 === 0 ? 160 : 40} ${270 + i * 220} ${i % 2 === 0 ? 160 : 40} ${330 + i * 220}`)
                .join(' ')} S100 ${kursHoehe - 40} 100 ${kursHoehe}`}
              fill="none"
              stroke="var(--color-navy)"
              stroke-width="2.5"
              stroke-linecap="round"
              vector-effect="non-scaling-stroke"
              pathLength="1"
            />
          </svg>
          <ol role="list" class="kurs__stationen">
            {stationen.map((s, i) => {
              const links = i % 2 === 0;
              const farbe = links ? 'red' : 'navy';
              return (
                <li class:list={['station', links ? 'station--links' : 'station--rechts']}>
                  <div class="station__text" lang={s.lang !== locale ? s.lang : undefined}>
                    {s.entwurf && <EntwurfLabel locale={locale} />}
                    <span class:list={['station__nummer t-kicker', `station__nummer--${farbe}`]}>{s.data.nummer}</span>
                    <h3 class="t-abschnitt">{s.data.titel}</h3>
                    <p class="station__beschreibung">{s.data.text}</p>
                  </div>
                  <div class="station__mitte" aria-hidden="true">
                    <svg class="station__tor" viewBox="0 0 48 60">
                      <line x1="6" y1="2" x2="6" y2="60" stroke={`var(--color-${farbe})`} stroke-width="3" />
                      <line x1="42" y1="2" x2="42" y2="60" stroke={`var(--color-${farbe})`} stroke-width="3" />
                      <path d="M6 6 L42 6 L42 30 L6 30 Z" fill={`var(--color-${farbe})`} />
                    </svg>
                  </div>
                </li>
              );
            })}
          </ol>
        </div>

        <details class="geschichte">
          <summary class="geschichte__knopf ohne-marker">
            <span class="geschichte__titel">
              <span class="t-abschnitt">{text.data.geschichte_titel}</span>
              <span class="geschichte__untertitel">{text.data.geschichte_untertitel}</span>
            </span>
            <span class="aufklapp-zeichen geschichte__plus" aria-hidden="true">
              +
            </span>
          </summary>
          <div class="geschichte__inhalt aufklapp-inhalt">
            {teile.map((teil, i) => (
              <div class="teil" lang={teil.lang !== locale ? teil.lang : undefined}>
                {teil.entwurf && <EntwurfLabel locale={locale} />}
                <h3 class="teil__titel t-abschnitt">
                  <Torflagge farbe={i % 2 === 0 ? 'red' : 'navy'} groesse="klein" />
                  <span>{teil.data.titel}</span>
                </h3>
                {teil.data.einleitung && <p>{teil.data.einleitung}</p>}
                {teil.data.resultate_liste && (
                  <ul role="list" class="teil__liste teil__liste--linien">
                    {resultate.map((r) => (
                      <li>
                        <span class:list={['teil__marke teil__marke--gross', r.podest && 'teil__marke--rot']}>{r.rang}</span>
                        <span>
                          <strong>{r.fett}</strong>, {r.rest}
                          {r.land && ` (${r.land})`}
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
                {teil.data.liste && (
                  <ul role="list" class="teil__liste">
                    {teil.data.liste.map((eintrag) => (
                      <li>
                        <span class="teil__marke">{eintrag.marke}</span>
                        <span>{eintrag.text}</span>
                      </li>
                    ))}
                  </ul>
                )}
                <div class="fliesstext">
                  <teil.Inhalt />
                </div>
              </div>
            ))}
          </div>
        </details>
      </div>
    </section>
  )
}

<style>
  .weg__innen {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .weg__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 720px;
  }

  /* Kurs: auf dem Handy eine Liste mit Tor links */
  .kurs {
    position: relative;
  }

  .kurs__linie {
    display: none;
  }

  .kurs__stationen {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .station {
    display: grid;
    grid-template-columns: var(--space-4) minmax(0, 1fr);
    gap: var(--space-2);
    align-items: start;
  }

  .station__mitte {
    order: -1;
  }

  .station__tor {
    width: calc(var(--space-4) - var(--space-1));
    height: auto;
  }

  .station__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
  }

  .station__nummer--red {
    color: var(--color-red);
  }

  .station__nummer--navy {
    color: var(--color-navy);
  }

  .station__beschreibung {
    max-width: 24rem;
    color: var(--color-ink-soft);
  }

  /* Desktop: Stationen abwechselnd links und rechts der Kurslinie */
  @media (min-width: 821px) {
    .kurs__linie {
      display: block;
      position: absolute;
      top: 0;
      left: 50%;
      width: 200px;
      margin-left: -100px;
      overflow: visible;
    }

    .kurs__stationen {
      position: relative;
      gap: 0;
    }

    .station {
      grid-template-columns: minmax(0, 1fr) 200px minmax(0, 1fr);
      gap: var(--space-4);
      align-items: center;
      height: var(--reihe);
    }

    .station__mitte {
      order: 0;
      position: relative;
      align-self: stretch;
    }

    .station__tor {
      position: absolute;
      top: calc(var(--space-4) + var(--space-1));
    }

    .station--links .station__tor {
      left: var(--space-2);
    }

    .station--rechts .station__tor {
      left: calc(200px - var(--space-4) - var(--space-2));
    }

    .station--links .station__text {
      grid-column: 1;
      align-items: flex-end;
      text-align: right;
    }

    .station--links .station__mitte {
      grid-column: 2;
      grid-row: 1;
    }

    .station--rechts .station__mitte {
      grid-column: 2;
      grid-row: 1;
    }

    .station--rechts .station__text {
      grid-column: 3;
      grid-row: 1;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      @keyframes linie-zeichnen {
        from {
          stroke-dashoffset: 1;
        }
        to {
          stroke-dashoffset: 0;
        }
      }

      @keyframes tor-hoch {
        from {
          opacity: 0;
          transform: scaleY(0.2);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      .kurs {
        view-timeline-name: --kurs;
      }

      .kurs__linie path {
        stroke-dasharray: 1;
        animation: linie-zeichnen linear both;
        animation-timeline: --kurs;
        animation-range: entry 10% cover 55%;
      }

      .station__tor {
        transform-origin: 50% 100%;
        animation: tor-hoch linear both;
        animation-timeline: view();
        animation-range: entry 10% entry 100%;
      }
    }
  }

  /* Meine ganze Geschichte */
  .geschichte {
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .geschichte__knopf {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: calc(var(--space-4) + var(--space-3));
    padding-block: var(--space-2);
  }

  .geschichte__titel {
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-1) / 2);
  }

  .geschichte__untertitel {
    color: var(--color-ink-soft);
  }

  .geschichte__plus {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    font-size: var(--type-titel-size);
  }

  .geschichte__knopf:hover .geschichte__plus {
    color: var(--color-navy);
  }

  .geschichte__inhalt {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: var(--space-4) calc(var(--space-4) + var(--space-2));
    max-width: 1140px;
    padding-block: var(--space-3) var(--space-4);
  }

  .teil {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    min-width: 0;
  }

  .teil__titel {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .teil__liste {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
  }

  .teil__liste li {
    display: grid;
    grid-template-columns: calc(var(--space-4) + var(--space-1)) minmax(0, 1fr);
    gap: var(--space-2);
    align-items: baseline;
  }

  .teil__liste--linien {
    gap: 0;
  }

  .teil__liste--linien li {
    padding-block: var(--space-1);
    border-top: 1px solid var(--color-line);
  }

  .teil__marke {
    font-family: var(--font-display);
    font-size: var(--type-lead-size);
    line-height: var(--type-abschnitt-line);
    font-weight: 700;
    color: var(--color-ink-soft);
  }

  .teil__marke--gross {
    font-size: var(--type-abschnitt-size);
    color: var(--color-navy);
  }

  .teil__marke--rot {
    color: var(--color-red);
  }

  .fliesstext {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
</style>
