---
/**
 * Sprachumschalter: wechselt auf die gleiche Seite in der anderen Sprache.
 * Gibt es eine Seite nur in einer Sprache (hasTranslation = false),
 * führt der Link zur Startseite der anderen Sprache.
 */
import { locales, localizePath, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  hasTranslation?: boolean;
}

const { locale, hasTranslation = true } = Astro.props;
const path = Astro.url.pathname;
---

<nav class="lang" aria-label={t(locale, 'lang.label')}>
  <ul role="list">
    {
      locales.map((l) => (
        <li>
          {l === locale ? (
            <span class="lang__item" aria-current="true" title={t(l, `lang.${l}`)}>
              {l.toUpperCase()}
            </span>
          ) : (
            <a
              class="lang__item"
              href={hasTranslation ? localizePath(path, l) : localizePath('/', l)}
              hreflang={l}
              lang={l}
              title={t(l, `lang.${l}`)}
            >
              <span aria-hidden="true">{l.toUpperCase()}</span>
              <span class="visually-hidden">{t(l, `lang.${l}`)}</span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .lang ul {
    display: flex;
    gap: var(--space-10);
  }

  .lang__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--space-44);
    min-height: var(--space-44);
    padding: var(--space-10) var(--space-2);
    font-family: var(--font-display);
    font-size: var(--size-15);
    font-weight: var(--weight-600);
    letter-spacing: var(--track-08);
    text-transform: uppercase;
    color: var(--color-tinte-soft);
    text-decoration: none;
  }

  .lang__item[aria-current] {
    color: var(--color-tinte);
    text-decoration: underline;
  }

  a.lang__item:hover {
    color: var(--color-beere);
    text-decoration: underline;
  }
</style>
