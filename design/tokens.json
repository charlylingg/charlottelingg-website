{
  "name": "Charlotte Lingg",
  "version": "2.0.0",
  "codename": "Torlauf",
  "color": {
    "paper": "#ffffff",
    "eis": "#eef3f8",
    "ink": "#0b1220",
    "ink-soft": "#41464c",
    "navy": "#002b7f",
    "red": "#ce1126",
    "nacht": "#041434",
    "line": "#c9cdd3",
    "line-soft": "#dcdfe2",
    "link": "{color.navy}"
  },
  "colorRules": [
    "Text immer ink oder ink-soft auf paper oder eis.",
    "Text immer paper auf navy, nacht oder red.",
    "red nie für Fliesstext.",
    "line und line-soft nie als Textfarbe."
  ],
  "font": {
    "display": {
      "family": "Barlow Condensed",
      "weights": [600, 700],
      "fallback": ["Arial Narrow", "sans-serif"]
    },
    "text": {
      "family": "Barlow",
      "weights": [400, 500, 700],
      "fallback": ["system-ui", "sans-serif"]
    }
  },
  "type": {
    "mega":      { "font": "display", "size": "80px", "lineHeight": 0.92, "weight": 700, "transform": "uppercase" },
    "titel":     { "font": "display", "size": "56px", "lineHeight": 0.95, "weight": 700, "transform": "uppercase" },
    "zahl":      { "font": "display", "size": "72px", "lineHeight": 0.9,  "weight": 700 },
    "abschnitt": { "font": "display", "size": "32px", "lineHeight": 1,    "weight": 700, "transform": "uppercase" },
    "zitat":     { "font": "display", "size": "36px", "lineHeight": 1.12, "weight": 600 },
    "kicker":    { "font": "text",    "size": "15px", "lineHeight": 1.2,  "weight": 600, "letterSpacing": "0.14em", "transform": "uppercase" },
    "lead":      { "font": "text",    "size": "19px", "lineHeight": 1.45, "weight": 500 },
    "text":      { "font": "text",    "size": "15px", "lineHeight": 1.55, "weight": 400 },
    "text-fett": { "font": "text",    "size": "15px", "lineHeight": 1.55, "weight": 700 },
    "label":     { "font": "text",    "size": "12px", "lineHeight": 1.3,  "weight": 700, "letterSpacing": "0.08em", "transform": "uppercase" },
    "klein":     { "font": "text",    "size": "13px", "lineHeight": 1.4,  "weight": 400 }
  },
  "typeNotes": "Werte gelten für Desktop. Auf dem Handy fluid mit clamp() skalieren, Fliesstext nie unter 15px.",
  "space": {
    "space-1": "8px",
    "space-2": "16px",
    "space-3": "24px",
    "space-4": "48px",
    "seitenrand": { "desktop": "72px", "mobile": "16px–24px" }
  },
  "radius": {
    "default": "0",
    "radius-punkt": "50%"
  },
  "radiusNotes": "Radius überall 0. Einzige Ausnahme radius-punkt für den Punkt im Zielbogen.",
  "shape": {
    "schraege": "-12deg"
  },
  "shapeNotes": "Erkennungszeichen ist die Schräge (skewX) bei Torflaggen und Schnittkanten."
}
